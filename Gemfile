source "https://rubygems.org"

# This uses the github-pages gem to mirror exactly what GitHub Pages runs.
gem "github-pages", group: :jekyll_plugins

# Plugins (already in _config.yml, declared again for the bundler)
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Windows / Ruby 3+ helpers
gem "wdm", "~> 0.1", platforms: [:mingw, :x64_mingw, :mswin]
gem "webrick", "~> 1.8"
